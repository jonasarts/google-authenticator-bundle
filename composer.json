{
    "name": "jonasarts/google-authenticator-bundle",
    "description": "A Google Authenticator Bundle for Symfony",
    "keywords": ["Google", "Authenticator", "HOTP", "TOTP"],
    "homepage": "https://github.com/jonasarts/google-authenticator-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonas Hauser",
            "email": "symfony@jonasarts.com",
            "homepage": "http://www.jonasarts.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-kernel": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0",
        "rector/rector": "^2.0"
    },
    "suggest": {
        "jonasarts/phpqrcode-bundle": "Render the getKeyURI() otpauth URI as a QR code without external services."
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "jonasarts\\Bundle\\GoogleAuthenticatorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jonasarts\\Bundle\\GoogleAuthenticatorBundle\\Tests\\": "tests/"
        }
    }
}
